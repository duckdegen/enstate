PORT=3000
REDIS_URL=redis://localhost:6379
# One or more comma-separated HTTP(S) JSON-RPC endpoints of the chain the Gwei Name Service lives on
RPC_URL=https://ethereum-rpc.publicnode.com
OPENSEA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
IPFS_GATEWAY=https://ipfs.io/ipfs/

# The Gwei Name Service contract (NameNFT) and Multicall3. These are the defaults, which are the same on mainnet and Sepolia
# GNS_CONTRACT=0x9D51D507BC7264d4fE8Ad1cf7Fe191933A0a81d6
# MULTICALL_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11

# Optionally you can specify a comma-seperated list PROFILE_RECORDS, however if not provided there are sensible defaults
# PROFILE_RECORDS=com.discord,com.twitter
# MAX_BULK_SIZE=10
# Longest time in seconds a cache entry may live. Entries are dropped earlier when a GNS event changes them
# PROFILE_CACHE_TTL=600

# The cache is kept in sync by following the logs of the GNS contract.
# WATCHER_ENABLED=true
# Optional WebSocket endpoint: events are then received as they are mined instead of at the next poll
# WS_RPC_URL=wss://ethereum-rpc.publicnode.com
# Seconds between two eth_getLogs polls
# WATCHER_POLL_INTERVAL=12
# Number of most recent blocks that are re-read on every poll to notice reorganizations
# WATCHER_REORG_DEPTH=12
# Largest block range to ask eth_getLogs for at once
# WATCHER_MAX_BLOCK_RANGE=1000
